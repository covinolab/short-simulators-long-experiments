@inproceedings{gloeckler2025compositional,
  author    = {Gloeckler, Manuel and Toyota, Shoji and Fukumizu, Kenji and Macke, Jakob H.},
  title     = {Compositional simulation-based inference for time series},
  booktitle = {International Conference on Learning Representations (ICLR)},
  year      = {2025},
  eprint    = {2411.02728},
  archivePrefix = {arXiv},
  url       = {https://proceedings.iclr.cc/paper_files/paper/2025/hash/aa539a128dc8653408dab242f6042c84-Abstract-Conference.html},
  comment   = {VERIFIED (arXiv, ICLR 2025 proceedings, poster 27993). CLOSEST METHODOLOGICAL ANALOGUE FOUND:
               trains on single-state transitions from a designed proposal, slices long series at
               deployment, requires proposal support at every attainable state, and shows NPE
               trained on short segments (Tmax=10) failing to generalize to longer series (SIR).
               Scope: Markovian, time-invariant transitions; no experimental microscopy.}
}

